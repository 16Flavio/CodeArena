# CodeArena environment configuration.
#
# Copy this file to `.env` in the same directory and fill in real values.
# The backend loads `.env` automatically at startup (via python-dotenv).
# Restart the backend after editing this file for changes to take effect.
#
# NOTE: `.env` is ignored by git. Never commit real credentials.

# ==========================================================================
# Email (SMTP) - used to deliver password-reset links.
# --------------------------------------------------------------------------
# If SMTP_HOST is empty or unset, the backend skips sending email and prints
# the reset URL to its terminal instead. That's fine for local testing.
# ==========================================================================

# The SMTP server to connect to.
#   Gmail:    smtp.gmail.com
#   Outlook:  smtp.office365.com
#   SendGrid: smtp.sendgrid.net
#   Mailgun:  smtp.mailgun.org
SMTP_HOST=

# TCP port. 587 is the standard for STARTTLS (what most providers use).
# Use 465 if your provider requires implicit SSL (and set SMTP_SSL=true).
SMTP_PORT=587

# Set to "true" only if your provider requires implicit SSL on connect
# (typically port 465). Leave empty for STARTTLS on port 587.
SMTP_SSL=

# Username used to authenticate with the SMTP server.
#   Gmail:    your full Gmail address (e.g. you@gmail.com)
#   SendGrid: the literal string "apikey"
#   Mailgun:  the SMTP username from their dashboard (e.g. postmaster@your.domain)
SMTP_USER=

# Password or API token for the SMTP user.
#   Gmail: create an App Password at https://myaccount.google.com/apppasswords
#          (16 chars; spaces optional). Your normal Gmail password will NOT work
#          - 2FA-protected accounts must use an App Password.
#   SendGrid: the API key from https://app.sendgrid.com/settings/api_keys
#   Mailgun:  the SMTP password from your domain's "SMTP credentials" page.
SMTP_PASS=

# The "From" address shown to the recipient. Can include a display name.
# If unset, SMTP_USER is used. Some providers (SendGrid, Mailgun) require the
# From address to match a verified sender/domain.
#   Example: CodeArena <no-reply@yourdomain.com>
SMTP_FROM=


# ==========================================================================
# Public URL of the frontend - used to build links in outgoing emails
# (like the password-reset URL). Defaults to http://localhost:5173 if unset.
# ==========================================================================
FRONTEND_URL=http://localhost:5173

# ==========================================================================
# Secret key used to sign JWT auth tokens.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# If unset, the server generates a random key at startup; sessions will then
# invalidate on every restart, which is fine for development but wrong for
# production.
# ==========================================================================
SECRET_KEY=

# ==========================================================================
# How long (in seconds) the scoring script is allowed to run per submission.
# Default: 30 seconds.
# ==========================================================================
SCORING_TIMEOUT_SECONDS=30

# ==========================================================================
# Scoring isolation mode.
#
#   docker      (RECOMMENDED for production) - run each admin-authored
#               scoring script and interactor in a throwaway container.
#               Required if you don't fully trust every admin account.
#               Needs the backend to have Docker socket access (already
#               wired in docker-compose.yml). Build the sandbox image
#               once, before the first submission:
#                   docker compose --profile build-only build scoring-image
#   subprocess  - run on the host with a wall-clock timeout + POSIX
#               rlimits. NO filesystem or network isolation. Fine for
#               a classroom with a single trusted admin; unsafe for a
#               public deployment.
# ==========================================================================
SCORING_MODE=docker
# Image tag used when SCORING_MODE=docker. Override if you build a custom one.
SCORING_IMAGE=codearena-scoring:latest
# Resource caps for the docker mode.
SCORING_MEMORY_MB=256
SCORING_CPUS=0.5

# ==========================================================================
# Database. docker-compose spins up a Postgres service by default - the
# composed URL below is what the backend reaches it at. Override only if
# you want to point at an external DB.
#
# For local non-Docker dev against SQLite (single-writer, fine for 1-2
# testers, NOT for real contests):
#   DATABASE_URL=sqlite:///./contest.db
# For remote Postgres:
#   DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/dbname
# Then run `alembic upgrade head` to apply schema.
# ==========================================================================
DATABASE_URL=
POSTGRES_USER=codearena
POSTGRES_PASSWORD=change-me
POSTGRES_DB=codearena

# ==========================================================================
# Scoring queue. docker-compose starts a redis service alongside the
# backend + a dedicated worker container. If REDIS_URL is unset the
# backend falls back to an in-process thread pool (dev only).
# ==========================================================================
REDIS_URL=redis://redis:6379/0
SCORING_QUEUE_NAME=scoring

# ==========================================================================
# Structured JSON logs - set to "json" to get one-line JSON records that
# Grafana/Loki/jq can parse. Any other value (or unset) = plain text.
# ==========================================================================
LOG_FORMAT=text
LOG_LEVEL=INFO

# ==========================================================================
# Optional: set SENTRY_DSN to forward errors to Sentry. Unset skips the SDK.
# ==========================================================================
SENTRY_DSN=
SENTRY_ENV=development
# SENTRY_TRACES=0.0   # set to e.g. 0.1 to sample 10% of requests
