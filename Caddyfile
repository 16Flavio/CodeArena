# System nginx on the host terminates TLS for challenge.vdrfinances.be
# and forwards plain HTTP to this Caddy (bound to 127.0.0.1:8080).
# Caddy's only job is the 500 MB body-size bump and SSE-friendly proxy
# to the frontend container, which in turn proxies /api/* to the backend.
:80 {
    encode zstd gzip

    request_body {
        max_size 500MB
    }

    # Security headers — applied here too in case nginx upstream is
    # bypassed by a future deploy change. HSTS is set assuming the host
    # nginx terminates TLS; if Caddy is *the* edge, raise max-age and
    # add ``preload``. ``include_subdomains`` left off until you're sure
    # every subdomain is HTTPS.
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Frame-Options "DENY"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "same-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
        # Suppress the default Caddy server header — small info-leak
        # reduction.
        -Server
    }

    reverse_proxy frontend:80 {
        flush_interval -1
    }
}
